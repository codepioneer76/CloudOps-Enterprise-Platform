# CloudOps Enterprise Platform Configuration
APP_NAME="CloudOps Enterprise Platform"
APP_ENV="development"
APP_VERSION="1.0.0"
DEBUG=true
HOST="127.0.0.1"
PORT=8000

# Storage Service Configuration (Options: local_memory, s3, minio)
STORAGE_BACKEND="local_memory"
STORAGE_BUCKET_DEFAULT="cloudops-artifacts"
S3_ENDPOINT_URL="http://localhost:9000"
AWS_ACCESS_KEY_ID="minioadmin"
AWS_SECRET_ACCESS_KEY="minioadmin"
AWS_REGION="us-east-1"

# Database Configuration (Options: mock, postgres)
DB_BACKEND="mock"
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="cloudops_db"
DB_USER="cloudops_user"
DB_PASSWORD="cloudops_secure_pass_local"
# Or provide full connection URL:
# DATABASE_URL="postgresql://cloudops_user:cloudops_secure_pass_local@localhost:5432/cloudops_db"

# ML Inference Configuration
ML_BACKEND="local_baseline"
ML_MODEL_VERSION="v1.0"
